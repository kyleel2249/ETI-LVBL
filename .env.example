# Copy to .env for local use. NEVER commit .env. On Cloudflare use `npx wrangler secret put NAME`.
# All keys are read on the server only; none are sent to the browser.

# ---- Safety (defaults shown; live trading is OFF unless you change these) ----
LIVE_TRADING_ENABLED=false          # master switch for any real-money order
ALPACA_PAPER=true                   # true = Alpaca paper endpoint
BINANCE_LIVE_TRADING_ENABLED=false  # also requires LIVE_TRADING_ENABLED=true
BINANCE_TESTNET_ENABLED=true
TRADING_KILL_SWITCH=false           # true blocks every order everywhere
DATA_MAX_AGE_SECONDS=60             # reject orders priced from older data

# ---- Alpaca (paper keys: https://app.alpaca.markets -> Paper Trading -> API keys) ----
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
# Live keys are separate and only used when ALPACA_PAPER=false AND LIVE_TRADING_ENABLED=true
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# ---- Binance (testnet keys: https://testnet.binance.vision) ----
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
# Production keys: create them READ-ONLY (no withdrawals, no trading) unless you intend live orders
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ---- FRED macro data (free key: https://fred.stlouisfed.org/docs/api/api_key.html) ----
FRED_API_KEY=

# ---- Storage (local) ----
# ETI_DATA_DIR=data                 # SQLite file lives at data/eti.db
# ETI_DB_PATH=
